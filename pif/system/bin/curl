#!/system/bin/sh
# Android DNS shim: static musl curl cannot use netd's resolver, so resolve
# the host through the system resolver (ping) and pin it with --resolve.
url=""
for a in "$@"; do
    case "$a" in
        http://*|https://*) url="$a" ;;
    esac
done
if [ -n "$url" ]; then
    host=$(echo "$url" | sed -E 's#^https?://([^/:]+).*#\1#')
    if [ -n "$host" ]; then
        ip=$(ping -c1 -W2 "$host" 2>/dev/null | head -n1 | sed -E 's/^PING [^(]+\(([0-9.]+)\).*/\1/')
        if [ -n "$ip" ]; then
            case "$url" in
                https://*) exec /system/bin/curl-real --resolve "$host:443:$ip" "$@" ;;
                *)         exec /system/bin/curl-real --resolve "$host:80:$ip" "$@" ;;
            esac
        fi
    fi
fi
exec /system/bin/curl-real "$@"
